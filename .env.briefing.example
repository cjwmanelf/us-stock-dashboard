# Local template only. Copy to ignored .env.local; never commit actual credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
STOCK_API_KEY=
MARKETAUX_API_KEY=
SEC_USER_AGENT=

# Current provider configuration; model selection is not a release approval.
BRIEFING_LLM_PROVIDER=anthropic
BRIEFING_LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
# Direct OpenAI-compatible mode only; leave both empty for Anthropic.
BRIEFING_LLM_BASE_URL=
BRIEFING_LLM_API_KEY=
# Separate random secret >=32 characters for owner-bound feedback tokens.
BRIEFING_FEEDBACK_SECRET=

# Local example: must match the browser origin exactly, without a trailing slash.
# Production: replace with the verified HTTPS service origin after creation.
# No wildcard, credentials, path, query or fragment. First origin is canonical
# for auth callbacks; comma-separated extra origins must each be explicitly trusted.
# Loopback HTTP is local-only; Cloud Run rejects missing/empty/invalid configuration.
BRIEFING_ALLOWED_ORIGINS=http://localhost:3000

# Metadata-only stdout logging is implemented by source code; it has no env toggle.
# No prompt/answer/evidence content, cookies or credentials should be logged.
BRIEFING_EVAL_MODE=false
BRIEFING_TRACE_CONTENT=false
LANGFUSE_ENABLED=false
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
OBSERVABILITY_USER_HASH_KEY=
# Runtime contract/prompt versions come from the frozen source (types.ts/service.ts).
# These optional Langfuse labels are not source-version overrides. If enabling that
# adapter later, fill them from the approved source; never assume a fixed v3 release.
APP_VERSION=
BRIEFING_PROMPT_VERSION=

# Isolated synthetic local evaluation only; keep empty in cloud environments.
BRIEFING_EVAL_SNAPSHOT_DIR=
BRIEFING_EVAL_USER_ID=
BRIEFING_EVAL_REQUEST_TOKEN=
